{
  "name": "dsh-one-pack",
  "version": "0.4.5",
  "description": "One Pack：把一个 DSH 环境的插件、设置、技能、会话打包同步到 GitHub，换机/换 profile 一键还原。",
  "type": "module",
  "license": "MIT",
  "author": "One Pack contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhang-Eli/dsh-one-pack.git"
  },
  "homepage": "https://github.com/Zhang-Eli/dsh-one-pack#readme",
  "bugs": {
    "url": "https://github.com/Zhang-Eli/dsh-one-pack/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "sync",
    "cross-device",
    "backup",
    "one-pack"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
